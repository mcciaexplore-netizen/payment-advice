# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already in .gitignore.

# Neon Postgres connection string (pooled connection recommended).
# Get this from the Neon dashboard -> Connection Details.
DATABASE_URL=postgres://user:password@ep-example-12345.region.aws.neon.tech/dbname?sslmode=require

# Vercel Blob read/write token.
# Get this from the Vercel dashboard -> Storage -> your Blob store -> .env.local tab.
BLOB_READ_WRITE_TOKEN=

# Real per-person Admin logins now live in the admin_users table (email +
# bcrypt password hash), seeded via `npm run seed:admin-users` — there is no
# single shared password env var anymore. (ADMIN_PASSWORD was retired when
# that shipped; if you see it referenced anywhere else, that's stale.)

# Secret used to sign/verify the admin session JWT (HS256).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Optional: only needed to run the lib/serial.ts integration tests
# (npm test) against a real Postgres instance. Point this at a scratch
# Neon branch or local Postgres — never at your real DATABASE_URL — since
# the tests write rows to serial_counters. Leave unset to skip those tests.
TEST_DATABASE_URL=

# --- Email (lib/email/notify.ts) ---

# "preview" (default if unset) — render + console.log only, never calls a
# real provider. "live" — actually sends via whichever provider
# EMAIL_PROVIDER selects. Must default to "preview" so nothing breaks if
# this var is missing anywhere (e.g. Preview deploys).
EMAIL_MODE=preview

# "gmail" (default if unset) or "resend". Gmail SMTP is the current interim
# live provider — mcciapune.com isn't DNS-verified in Resend yet, and Gmail
# works immediately with no DNS wait (trade-off: mail shows as coming from
# a Gmail address, not an official MCCIA domain, until that's done). Switch
# to EMAIL_PROVIDER=resend once mcciapune.com is verified — the Resend code
# path is fully intact, just dormant while gmail is the default.
EMAIL_PROVIDER=gmail

# Only used when EMAIL_PROVIDER=gmail (the default) and EMAIL_MODE=live.
# GMAIL_USER is also used as the "from" address — Gmail SMTP requires the
# authenticated account and the "from" header to match, you can't send "as"
# a different address the way Resend allows with a verified domain.
# GMAIL_APP_PASSWORD is a 16-character App Password generated at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# on the account) — NOT the account's normal login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Only used when EMAIL_PROVIDER=resend. Resend API key, from the Resend
# dashboard -> API Keys.
RESEND_API_KEY=

# Only used when EMAIL_PROVIDER=resend. Sender address. Defaults to
# Resend's shared testing domain (onboarding@resend.dev) if unset — do NOT
# point this at a mcciapune.com address until that domain is DNS-verified
# in Resend.
EMAIL_FROM=onboarding@resend.dev

# When EMAIL_MODE=live and this is set, EVERY email is redirected to this
# address instead of its real computed recipient, with the subject
# prefixed "[TEST — would go to: {real_recipient}] " — lets you verify the
# full render->send->deliver pipeline against your own inbox before
# trusting real recipient data. Leave unset once ready for production
# (EMAIL_MODE=live with no override sends to real recipients). Applies to
# both providers identically.
EMAIL_TEST_OVERRIDE_RECIPIENT=
